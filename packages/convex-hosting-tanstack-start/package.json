{
  "name": "@samebase/convex-hosting-tanstack-start",
  "version": "0.11.0",
  "description": "Render TanStack Start pages in a Convex HTTP action.",
  "keywords": [
    "convex",
    "hosting",
    "ssr",
    "tanstack-start"
  ],
  "homepage": "https://github.com/samebase/convex-hosting/tree/main/packages/convex-hosting-tanstack-start#readme",
  "bugs": {
    "url": "https://github.com/samebase/convex-hosting/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/convex-hosting.git",
    "directory": "packages/convex-hosting-tanstack-start"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server-build": {
      "types": "./dist/server-build.d.ts"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const name of ['server-build', 'server-module']) require('node:fs').copyFileSync('src/' + name + '.d.ts', 'dist/' + name + '.d.ts')\"",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@samebase/convex-hosting": "workspace:*",
    "@tanstack/react-start": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@samebase/convex-hosting": ">=0.13.0",
    "@tanstack/react-start": "^1.168.60",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@samebase/convex-hosting": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}

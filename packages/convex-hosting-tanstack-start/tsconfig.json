{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      // The `convexAuth()` Vite plugin aliases this specifier for apps; tsc needs the same file.
      "@convex-dev/auth/ssr/nextjs/client": [
        "./node_modules/@convex-dev/auth/dist/ssr/nextjs/client.d.ts"
      ]
    }
  },
  "include": ["src"]
}

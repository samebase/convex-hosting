{
  "name": "@samebase/convex-hosting",
  "version": "0.6.0",
  "description": "A Convex component that hosts a web app: static files, with optional server rendering.",
  "keywords": [
    "component",
    "convex",
    "hosting"
  ],
  "homepage": "https://github.com/samebase/convex-hosting#readme",
  "bugs": {
    "url": "https://github.com/samebase/convex-hosting/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/convex-hosting.git",
    "directory": "packages/convex-hosting"
  },
  "bin": {
    "convex-hosting": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/client/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/types.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.build.json --force && node scripts/copy-declarations.ts",
    "build:codegen": "convex codegen --component-dir ./src/component && pnpm run build",
    "prepare": "pnpm run build",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "catalog:",
    "mime": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "convex": "catalog:",
    "convex-test": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.46.0"
  }
}

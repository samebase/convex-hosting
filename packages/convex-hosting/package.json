{
  "name": "@samebase/convex-hosting",
  "version": "0.4.0",
  "description": "A Convex component that hosts a web app: static files, with optional server rendering.",
  "keywords": [
    "component",
    "convex",
    "hosting"
  ],
  "homepage": "https://github.com/samebase/convex-hosting#readme",
  "bugs": {
    "url": "https://github.com/samebase/convex-hosting/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/convex-hosting.git",
    "directory": "packages/convex-hosting"
  },
  "bin": {
    "convex-hosting": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "vendor/files",
    "CHANGELOG.md",
    "INTEGRATION.md",
    "NOTICE"
  ],
  "type": "module",
  "module": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./files/convex.config": {
      "types": "./vendor/files/dist/component/convex.config.d.ts",
      "default": "./vendor/files/dist/component/convex.config.js"
    },
    "./files/convex.config.js": {
      "types": "./vendor/files/dist/component/convex.config.d.ts",
      "default": "./vendor/files/dist/component/convex.config.js"
    },
    "./files/_generated/component.js": {
      "types": "./vendor/files/dist/component/_generated/component.d.ts"
    },
    "./files/_generated/component": {
      "types": "./vendor/files/dist/component/_generated/component.d.ts"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.ts",
    "build:files": "node ./scripts/build.ts --files-only",
    "build:codegen": "pnpm run build:files && convex codegen --component-dir ./src/component && pnpm run build",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --build ./tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "convex-helpers": "catalog:"
  },
  "devDependencies": {
    "@samebase/convex-files": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "convex": "catalog:",
    "convex-test": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.46.0",
    "react": "^18.3.1 || ^19.0.0"
  }
}
